# Uncomment and fill in ONE provider. If both keys are set, OpenRouter is used.

# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternatively, use OpenAI directly:
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Optional: models for the Image and Audio (voice-over) formats. Both need OpenRouter credit.
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OPENROUTER_AUDIO_MODEL=openai/gpt-audio-mini
